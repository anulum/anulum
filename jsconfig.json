{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@atlas/*": ["./docs/atlas/*.js"]
    },
    "moduleDetection": "force"
  },
  "include": [
    "docs/atlas/*.js",
    "tests/*.mjs",
    "tools/*.mjs",
    "*.config.mjs",
    "types/*.d.ts",
    "tests/*.ts"
  ]
}
